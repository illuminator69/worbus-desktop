<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>app.worbus.desktop</id>
  <name>Worbus</name>
  <summary>Jellyfin, Navidrome, and OpenSubsonic Compatible Music Player</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <content_rating type="oars-1.1"/>
  <description>
    <p>A music player for your self-hosted music server: Navidrome, Jellyfin, and OpenSubsonic servers, and the Worbus Server beside them.</p>
    <p>Worbus for desktop is a fork of Feishin by Jeff Li. Licensed GPL-3.0, like the original. Worbus is not affiliated with Navidrome.</p>
    <p>Features</p>
    <ul>
      <li>MPV player backend</li>
      <li>Web player backend</li>
      <li>Jellyfin server support</li>
      <li>Navidrome server support</li>
      <li>OpenSubsonic server support</li>
      <li>Scrobble playback to your server</li>
      <li>Smart playlist editor (Navidrome)</li>
      <li>Synchronized and unsynchronized lyrics support</li>
    </ul>
  </description>
  <developer id="app.worbus">
